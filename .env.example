# GateStream 3.0.1 · Go runtime
# System environment > .env > config.env > legacy start.sh assignments > defaults.
# Explicit empty system values override files. Restart after editing.
# Comments/blanks are ignored. Both quote styles, BOM and CRLF work.
# Quote values containing spaces or an inline comment marker. Dollar signs remain literal.
# Preserve existing values when upgrading.

TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=REPLACE_WITH_32_CHARACTER_API_HASH
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
TELEGRAM_BOT_USERNAME=YourGateStreamBot
OWNER_ID=1234567890

# Empty disables additional workers. Separate actual tokens with commas, spaces or semicolons.
# Example worker tokens in comments are ignored.
MULTI_BOT_TOKENS=""
TELEGRAM_CHANNEL_ID=""
SECRET_CODE_LENGTH=24

DATABASE_URL=mongodb://localhost:27017
DATABASE_NAME=OmniArchiver
OMNI_MONGO_URI=""

# Configure the values assigned by your hosting provider.
BIND_ADDRESS=0.0.0.0
PORT=8080
BASE_URL=https://yourdomain.example

# Existing encrypted owner sessions are read from MongoDB automatically.
# These optional settings retain compatibility with manually supplied Hydrogram sessions.
WORKER_REPAIR_API_ID=""
WORKER_REPAIR_API_HASH=""
WORKER_REPAIR_SESSION=""

MAL_CLIENT_ID=""
OMDB_API_KEY=""

MEDIA_CACHE_MAX_MB=500
MEDIA_CACHE_DIR=""
CACHE_FREE_MB=64
MEMORY_CLEAN_MB=420
MEMORY_RESTART_MB=498
HANDLER_WORKERS=2
# Go scheduler CPU limit. IO_WORKERS remains a legacy alias. System GOMAXPROCS takes precedence.
GO_MAX_PROCS=4
MAX_TRANSMISSIONS=4
# Omit to derive the connection limit from MAX_TRANSMISSIONS, with a minimum of eight.
MAX_HTTP_CONNECTIONS=16
SHUTDOWN_TIMEOUT=20
SESSION_DIR=sessions-go
LOG_FILE=""
