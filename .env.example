# GateStream-Lite — centralized configuration (Python 3.11+)
# Precedence per key: system environment > .env > config.env > literal start.sh > defaults.
# An explicitly empty system value also overrides the files. Restart after editing.
# Comments/blanks are ignored; duplicate active keys use their last assignment.
# Use quotes for spaces/#/=; UTF-8 BOM and CRLF are supported. No shell execution.
# Preserve existing database names, URI, bot token and owner when upgrading.
# ================= TELEGRAM CONFIG =================
# API credentials from https://my.telegram.org
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here

# Primary Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
TELEGRAM_BOT_USERNAME=YourGateStreamBot

# Multi-Client Worker Tokens (optional, whitespace, comma or semicolon separated for parallel streaming)
# Keep blank to disable extras. Comments/examples are never interpreted as tokens.
# Duplicate, malformed and placeholder entries are ignored; failed workers are isolated.
MULTI_BOT_TOKENS=""

# Optional legacy credentials. Use /workersetup in the bot for automatic storage.
WORKER_REPAIR_API_ID=""
WORKER_REPAIR_API_HASH=""
WORKER_REPAIR_SESSION=""

# Bot owner. Grant access to users and groups in Telegram with /auth.
OWNER_ID=1234567890

# Optional: Fallback Storage / Dump Channel ID (with -100 prefix)
# Used for uploads, first-start user notices, and /workers log checks.
# Each bot needs posting permission to pass the check.
TELEGRAM_CHANNEL_ID=""
SECRET_CODE_LENGTH=24

# ================= DATABASE CONFIG =================
# Local/VPS MongoDB URL. Hosted deployments need an externally reachable endpoint.
DATABASE_URL=mongodb://localhost:27017
# Legacy database name retained so upgrades keep existing records.
DATABASE_NAME=OmniArchiver
# Optional separate upstream catalog; blank uses OmniArchiverDB on DATABASE_URL.
OMNI_MONGO_URI=""

# ================= WEB SERVER CONFIG ===============
# Spaces: add credentials as Settings > Secrets, do not upload a filled .env.
# Spaces auto-detects BASE_URL from SPACE_HOST; omit BASE_URL there unless using a custom domain.
# Docker sets its port in the image environment; environment values take priority.
# Serv00: set your reserved TCP port here; see SERV00.md.
# Public base URL of your VPS or domain (e.g. https://yourdomain.com or http://YOUR_VPS_IP:8080)
BASE_URL=https://yourdomain.com
BIND_ADDRESS=0.0.0.0
PORT=8080

# Automatic classification: AniList works without a key.
# Optional: your own MyAnimeList application client ID (public anime lookup).
MAL_CLIENT_ID=""
# Optional: OMDb API key for movies/series, IMDb IDs and available Rotten Tomatoes ratings.
OMDB_API_KEY=""

# Resumable ZIP preparation: total temporary ZIP storage limit in MiB (default 8 GiB; 0 disables ZIP caching).
ZIP_CACHE_MAX_MB=8192
# Optional directory on a persistent volume; blank uses cache/archives under the app.
ZIP_CACHE_DIR=""

# Optional media head/tail disk cache; 0 disables it. Small hosts can use 64.
MEDIA_CACHE_MAX_MB=500
MEDIA_CACHE_DIR=""
# Free filesystem space to leave untouched. Individual account quota may be lower.
CACHE_FREE_MB=64
# Memory cleanup / graceful restart thresholds in MiB; restart 0 disables restart.
MEMORY_CLEAN_MB=420
MEMORY_RESTART_MB=498
# Bound thread pools/concurrent Telegram transfers; reduce for shared hosting.
HANDLER_WORKERS=2
IO_WORKERS=4
MOTOR_MAX_WORKERS=4
MAX_TRANSMISSIONS=4
# HTTP request-drain timeout and allowed forwarding proxies.
SHUTDOWN_TIMEOUT=20
TRUSTED_PROXY_IPS=127.0.0.1
# Relative paths resolve against the project. Empty selects the normal rotating log.
LOG_FILE=""
