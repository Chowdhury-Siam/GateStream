# GateStream — Gateway to your media
# ================= TELEGRAM CONFIG =================
# API credentials from https://my.telegram.org
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here

# Primary Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_USERNAME=YourGateStreamBot

# Multi-Client Worker Tokens (optional, space or comma separated for parallel streaming)
# Example: MULTI_BOT_TOKENS="token1 token2 token3"
MULTI_BOT_TOKENS=""

# Owner & Authorized Admins (space-separated Telegram user IDs)
OWNER_ID=1234567890
AUTH_USERS=""

# Allowed Users for general usage (leave empty to allow everyone)
ALLOWED_USER_IDS=""

# Optional: Fallback Storage / Dump Channel ID (with -100 prefix)
# Used for private-DM file storage and first-start user notices.
# The bot needs permission to post. Leave empty to disable both.
TELEGRAM_CHANNEL_ID=""
SECRET_CODE_LENGTH=24

# ================= DATABASE CONFIG =================
# Local/VPS MongoDB URL. Spaces needs an external endpoint on an allowed port (see HUGGING_FACE.md).
DATABASE_URL=mongodb://localhost:27017
# Legacy database name retained so upgrades keep existing records.
DATABASE_NAME=OmniArchiver
# Optional separate upstream catalog; blank uses OmniArchiverDB on DATABASE_URL.
OMNI_MONGO_URI=""

# ================= WEB SERVER CONFIG ===============
# Spaces: add credentials as Settings > Secrets, do not upload a filled .env.
# Spaces auto-detects BASE_URL from SPACE_HOST; omit BASE_URL there unless using a custom domain.
# For Docker locally, use PORT=7860 and map your external port to container port 7860.
# Public base URL of your VPS or domain (e.g. https://yourdomain.com or http://YOUR_VPS_IP:8080)
BASE_URL=https://yourdomain.com
BIND_ADDRESS=0.0.0.0
PORT=8080

# Automatic classification: AniList works without a key.
# Optional: your own MyAnimeList application client ID (public anime lookup).
MAL_CLIENT_ID=""
# Optional: OMDb API key for movies/series, IMDb IDs and available Rotten Tomatoes ratings.
OMDB_API_KEY=""

# Resumable ZIP preparation: total temporary ZIP storage limit in MiB (default 8 GiB).
ZIP_CACHE_MAX_MB=8192
# Optional directory on a persistent volume; blank uses cache/archives under the app.
ZIP_CACHE_DIR=""
